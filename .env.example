# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (used directly for local dev; docker-compose sets DATABASE_URL itself) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=bibliotech

# Alternative: set the full URL directly (takes precedence over DB_* above)
# DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/bibliotech

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
